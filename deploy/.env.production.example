# Copy to /opt/stone-app/.env on the VPS and replace every placeholder.
# This file is an example only; never commit the real .env.
NODE_ENV=production
PORT=3000
DYNAMODB_ENDPOINT=https://dynamodb.replace-with-aws-region.amazonaws.com
AWS_REGION=replace-with-aws-region
DYNAMODB_TABLE_PREFIX=
USERS_TABLE_NAME=stone_users
PRODUCTS_TABLE_NAME=stone_products
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=stone-api
JWT_AUDIENCE=stone-web
JWT_ACCESS_TTL_SECONDS=900
ALLOWED_ORIGINS=https://replace-with-frontend-domain.example
TRUSTED_PROXY_IPS=172.30.0.2
COOKIE_NAME=__Host-stone_access_token
COOKIE_SECURE=true
